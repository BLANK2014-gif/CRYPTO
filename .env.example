# =============================================================================
# Roostoo Trading Bot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Roostoo API Credentials ---
ROOSTOO_API_KEY=""
ROOSTOO_SECRET_KEY=""

# --- Dashboard Security ---
DASHBOARD_TOKEN=your_secure_dashboard_token_here
DASHBOARD_HOST="0.0.0.0"
DASHBOARD_PORT="8080"

# --- Trading Mode ---
# Set to "true" for live trading, "false" for dry-run
LIVE_TRADING_ENABLED="false"

# --- Logging ---
LOG_LEVEL="INFO"
